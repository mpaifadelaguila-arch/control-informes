# Copia este archivo como secrets.toml (en local) o pega su contenido en
# Streamlit Cloud > Settings > Secrets. secrets.toml NO se sube a GitHub.

# Clave para entrar a la app (obligatoria).
app_password = "cambia-esta-clave"

# Respaldo en Google Drive (opcional, pero necesario en Streamlit Cloud para no perder datos).
# Usa una carpeta propia de préstamos, distinta a la de los informes, compartida con la cuenta de servicio.
prestamos_drive_folder_id = "ID_DE_LA_CARPETA"

[gcp_service_account]
# Mismos campos que el JSON de la cuenta de servicio (type, project_id, private_key_id, private_key, client_email, ...).
